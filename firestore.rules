rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public registration:
    // Anyone may create a new membership registration.
    // Only the authorized administrator can read, update, or delete members.
    match /members/{memberId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'firstName',
          'lastName',
          'phone',
          'membershipCategory',
          'membershipType',
          'status',
          'submittedAt'
        ])
        && request.resource.data.status == 'pending';

      allow read, update, delete: if
        request.auth != null
        && request.auth.token.email == 'tcss2026@gmail.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
